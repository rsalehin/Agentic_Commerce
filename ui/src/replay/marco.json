  "rules": [
    {
      "id": "R-MND-01",
      "step": "any",
      "outcome": "ERROR",
      "reason_code": "MANDATE_SCOPE_EXCEEDED",
      "law": "BGB §§ 164 ff. (Zurechnung), Mandatsmodell; AP2-Mandate als Vorbild",
      "message_de": "Die Anfrage überschreitet das vom Kunden erteilte Mandat."
    },
    {
      "id": "R-MND-02",
      "step": "any",
      "outcome": "ERROR",
      "reason_code": "MANDATE_EXPIRED",
      "law": "GwG §10 Abs. 1 Nr. 5 (Aktualität), Mandatsmodell",
      "message_de": "Das Mandat ist abgelaufen. Bitte neu erteilen."
    },
    {
      "id": "R-MND-03",
      "step": "any",
      "outcome": "DENY",
      "reason_code": "MANDATE_REVOKED",
      "law": "Mandatsmodell (Widerruflichkeit); re-checked on every write",
      "message_de": "Das Mandat wurde widerrufen."
    },
    {
      "id": "R-MND-04",
      "step": "start",
      "outcome": "DENY",
      "reason_code": "AGENT_UNVERIFIED",
      "law": "AMLR Art. 20 Abs. 1 lit. i (im Namen des Kunden Handelnde); AI Act Art. 50 (Transparenz)",
      "message_de": "Der Agent konnte nicht verifiziert werden."
    },
    {
      "id": "R-MND-05",
      "step": "any",
      "outcome": "ERROR",
      "reason_code": "CLIENT_UNREGISTERED",
      "law": "DORA Art. 28 ff. (IKT-Drittparteien); Zulassung/Registrierung externer Clients",
      "message_de": "Der aufrufende Client ist nicht registriert oder gesperrt."
    },
    {
      "id": "R-MND-06",
      "step": "any",
      "outcome": "ERROR",
      "reason_code": "SENDER_BINDING_INVALID",
      "law": "DORA Art. 28 ff.; Sender-Bindung (DPoP-artiger Nachweis) der Willenserklärung an den Client",
      "message_de": "Der Sender-Nachweis des Agenten ist ungültig."
    },
    {
      "id": "R-ID-01",
      "step": "identify",
      "outcome": "REQUIRE_CUSTOMER",
      "reason_code": "ID_VERIFICATION_FAILED",
      "law": "GwG §12 Abs. 1, §13 Abs. 1; AMLR Art. 22 Abs. 6 lit. b (eIDAS-konforme Identifizierung)",
      "message_de": "Die Identität konnte nicht elektronisch bestätigt werden. Bitte erneut ausweisen."
    },
    {
      "id": "R-ID-02",
      "step": "identify",
      "outcome": "REQUIRE_REVIEW",
      "reason_code": "ID_NON_EU_DOCUMENT",
      "law": "AMLR Art. 22 Abs. 6; RTS Art. 7 (Ausnahme nur wenn eIDAS-Mittel nicht verfügbar)",
      "message_de": "Für Ausweisdokumente außerhalb EU/EWR ist eine persönliche Prüfung erforderlich."
    },
    {
      "id": "R-ID-03",
      "step": "identify",
      "outcome": "REQUIRE_REVIEW",
      "reason_code": "ID_UNDERAGE",
      "law": "BGB §§ 106 ff. (beschränkte Geschäftsfähigkeit)",
      "message_de": "Minderjährige können ein Depot nur mit gesetzlichen Vertretern eröffnen."
    },
    {
      "id": "R-ID-04",
      "step": "identify",
      "outcome": "REQUIRE_REVIEW",
      "reason_code": "NAME_MISMATCH_REFERENCE_ACCOUNT",
      "law": "GwG §10 Abs. 1 Nr. 1 i.V.m. Referenzkontoprinzip",
      "message_de": "Der Kontoinhaber des Referenzkontos stimmt nicht mit der identifizierten Person überein."
    },
    {
      "id": "R-ID-05",
      "step": "identify",
      "outcome": "DENY",
      "reason_code": "HOLDER_MANDATE_MISMATCH",
      "law": "BGB §§ 164 ff. (Zurechnung); Mandatsmodell — Bindung des Mandats an die identifizierte Person",
      "message_de": "Die identifizierte Person stimmt nicht mit dem Aussteller des Mandats überein."
    },
    {
      "id": "R-AML-01",
      "step": "identify",
      "outcome": "REQUIRE_REVIEW",
      "reason_code": "AML_SANCTIONS_HIT",
      "law": "EU-Sanktionsverordnungen; GwG §10 Abs. 1 Nr. 5, §47 (Vertraulichkeit)",
      "message_de": "Ihr Antrag wird geprüft."
    },
    {
      "id": "R-AML-02",
      "step": "identify",
      "outcome": "REQUIRE_REVIEW",
      "reason_code": "AML_PEP_HIT",
      "law": "GwG §15 Abs. 3 Nr. 1 (verstärkte Sorgfaltspflichten bei PEP); §47",
      "message_de": "Ihr Antrag wird geprüft."
    },
    {
      "id": "R-AML-03",
      "step": "identify",
      "outcome": "REQUIRE_REVIEW",
      "reason_code": "AML_HIGH_RISK_COUNTRY",
      "law": "GwG §15 Abs. 3 Nr. 2 (Drittstaaten mit hohem Risiko); §47",
      "message_de": "Ihr Antrag wird geprüft."
    },
    {
      "id": "R-TAX-01",
      "step": "tax_declaration",
      "outcome": "REQUIRE_CUSTOMER",
      "reason_code": "TAX_ID_MISSING",
      "law": "AO §139b; EStG §44a",
      "message_de": "Ohne Steuer-Identifikationsnummer kann das Depot nicht eröffnet werden."
    },
    {
      "id": "R-TAX-02",
      "step": "tax_declaration",
      "outcome": "REQUIRE_REVIEW",
      "reason_code": "TAX_FOREIGN_RESIDENCY",
      "law": "FKAustG §3a Abs. 2 (CRS-Selbstauskunft)",
      "message_de": "Bei steuerlicher Ansässigkeit im Ausland prüft ein Mitarbeiter die Selbstauskunft."
    },
    {
      "id": "R-TAX-03",
      "step": "tax_declaration",
      "outcome": "REQUIRE_REVIEW",
      "reason_code": "TAX_US_INDICIA",
      "law": "FATCA-Abkommen DE/USA; FATCA-USA-UmsV",
      "message_de": "Bei US-Bezug sind zusätzliche Formulare (W-9/W-8BEN) erforderlich."
    },
    {
      "id": "R-TAX-04",
      "step": "tax_declaration",
      "outcome": "REQUIRE_CUSTOMER",
      "reason_code": "TAX_DECLARATION_UNSIGNED",
      "law": "FKAustG §3a Abs. 2 (Erklärung des Kontoinhabers); BGB Zurechnung",
      "message_de": "Die steuerliche Selbstauskunft muss vom Kunden selbst bestätigt werden."
    },
    {
      "id": "R-SVC-01",
      "step": "appropriateness",
      "outcome": "ALLOW",
      "reason_code": null,
      "law": "WpHG §63 Abs. 10/11 — die Pflicht knüpft an die Dienstleistung, nicht an das leere Depot",
      "message_de": null
    },
    {
      "id": "R-WPHG-01",
      "step": "appropriateness",
      "outcome": "REQUIRE_CUSTOMER",
      "reason_code": "PRODUCT_OUTSIDE_UNLOCKED",
      "law": "WpHG §63 Abs. 10 (Angemessenheitsprüfung); MaComp BT 6",
      "message_de": "Für die gewünschten Produktklassen liegen keine ausreichenden Kenntnisse und Erfahrungen vor (Warnhinweis nach §63 Abs. 10 WpHG)."
    },
    {
      "id": "R-WPHG-02",
      "step": "appropriateness",
      "outcome": "REQUIRE_REVIEW",
      "reason_code": "ADVICE_REQUESTED",
      "law": "WpHG §64 Abs. 3 (Geeignetheitsprüfung bei Anlageberatung)",
      "message_de": "Eine Anlageberatung erfolgt durch Ihre Partnerbank. Wir vermitteln einen Termin."
    },
    {
      "id": "R-WPHG-03",
      "step": "appropriateness",
      "outcome": "REQUIRE_REVIEW",
      "reason_code": "COMPLEX_PRODUCT",
      "law": "WpHG §63 Abs. 11 (Execution-only nur für nicht-komplexe Instrumente)",
      "message_de": "Komplexe Finanzinstrumente sind im Agentenkanal nicht autonom freischaltbar."
    },
    {
      "id": "R-CTR-01",
      "step": "sign_contract",
      "outcome": "REQUIRE_CUSTOMER",
      "reason_code": "CONTRACT_UNSIGNED",
      "law": "BGB §§ 312c ff. (Fernabsatz), eIDAS Art. 25 (QES); Zurechnung der Willenserklärung",
      "message_de": "Der Depotvertrag muss vom Kunden persönlich signiert werden."
    },
    {
      "id": "R-CTR-02",
      "step": "sign_contract",
      "outcome": "REQUIRE_CUSTOMER",
      "reason_code": "SNAPSHOT_STALE",
      "law": "BGB Vertragsschluss — Antrag und Annahme müssen inhaltlich übereinstimmen; Fernabsatz-Informationspflichten",
      "message_de": "Die Vertragsunterlagen haben sich geändert. Bitte bestätigen Sie die aktualisierte Zusammenfassung erneut."
    }
  ]
